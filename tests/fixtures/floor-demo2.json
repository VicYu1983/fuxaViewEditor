            "parameters": [],
            "mode": "CLIENT",
            "code": "const voiceOn = $getTag(\"t_5376140e-37d1b535\" /* FUXA - voiceOn */);\nif (voiceOn) {\n  $setTag(\"t_5376140e-37d1b535\" /* FUXA - voiceOn */, false);\n  const message = $getTag(\"t_ef1bd472-12dca2fb\" /* FUXA - voiceMessage */);\n  const repeatTag = $getTag(\"t_8abc20ae-e2eaa7a8\" /* FUXA - voiceRepeat */);\n  const repeat = Math.min(10, Math.max(1, Math.round(Number(repeatTag) || 1)));\n  const voice = speechSynthesis.getVoices().find(v => v.lang === 'zh-TW' && v.localService);\n  let played = 0;\n  const speakOnce = () => {\n    const u = new SpeechSynthesisUtterance(message);\n    if (voice) u.voice = voice;\n    u.lang = 'zh-TW';\n    u.onend = () => {\n      played += 1;\n      if (played < repeat) speakOnce();\n    };\n    speechSynthesis.speak(u);\n  };\n  speakOnce();\n}",
